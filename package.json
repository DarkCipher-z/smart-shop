{
  "name": "smart-shop",
  "version": "1.0.0",
  "description": "Smart Shop — Smart Inventory & Billing for Local Shops",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "seed": "node server/seed.js",
    "start": "node server/index.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "concurrently": "^9.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.1"
  }
}
