# Smart Shop — Environment Configuration Template
# Copy this file to .env and configure your production secrets

# Server Port
PORT=3001
NODE_ENV=production

# JWT Authentication Secret (Use a strong random 256-bit key in production)
JWT_SECRET=smartshop_jwt_super_secret_production_key_2026_change_in_prod

# Persistent Database File Path
DATABASE_PATH=./server/smartshop.db

# Initial Admin & Shopkeeper Default Password (used only on first seed)
INITIAL_SEED_PASSWORD=SmartShop@2026

# CORS Allowed Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://your-domain.com
